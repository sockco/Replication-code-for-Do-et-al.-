Model5 <- lm(
  Avg_Score ~
    race_diversity_gs_norm +
    ses_diversity_gs_norm +
    pol_diversity_gs_norm +
    gender_diversity_gs_norm +
    total_interaction_exposure +
    respondents_race +
    gender_num +
    age_cohort +
    mother_edu_years +
    hs_gpa_num +
