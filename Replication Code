# =========================================================
# REPLICATION ANALYSIS
# =========================================================
#
# This script reproduces the analyses reported in the associated study.
# It is designed for use with the publicly available, de-identified
# replication dataset.
#
# Network diversity measures were constructed from the restricted
# original data prior to de-identification. The public replication
# dataset therefore contains pre-constructed normalized Gini-Simpson
# indices for racial, socioeconomic, political, and gender diversity.
#
# Total interaction exposure and dimension-specific outgroup exposure
# measures were also constructed prior to de-identification and are
# included as pre-constructed variables in the replication dataset.
#
# The public dataset contains the complete-case analytic sample used
# for the models below. No friend-level attributes or original
# respondent identifiers are included.
#
# Software used for the original analysis:
# R version 4.5.1 (2025-06-13)
#
# =========================================================

rm(list = ls())

# ---------------------------------------------------------
# Packages
# ---------------------------------------------------------

library(dplyr)
library(readr)
library(tidyr)
library(parameters)


# ---------------------------------------------------------
# Load de-identified replication data
# ---------------------------------------------------------

setwd("C://Users//jkosa//Documents//R//MUST Project - Perspective Taking Project//Data")

# If necessary, change this path to the location of the downloaded CSV.
df_analysis <- read_csv(
  "2. [No Friends] replication_data.csv",
  show_col_types = FALSE
)


# ---------------------------------------------------------
# Prepare categorical variables
# ---------------------------------------------------------

# Explicitly restore the reference categories used in the original
# analysis. White is the reference category for respondent race.
df_analysis <- df_analysis %>%
  mutate(
    respondents_race = factor(
      respondents_race,
      levels = c("White", "Asian", "Latino", "Other")
    ),
    gender_num = as.numeric(gender_num),
    Form = factor(Form)
  )


# ---------------------------------------------------------
# Replication checks
# ---------------------------------------------------------

# Analytic sample size
nrow(df_analysis)

# =========================================================
# MAIN REGRESSION MODELS
# =========================================================

# ---------------------------------------------------------
# Model 1: General interaction intensity
# ---------------------------------------------------------

Model1 <- lm(
  Avg_Score ~
    total_interaction_exposure +
    respondents_race +
    gender_num +
    age_cohort +
    mother_edu_years +
    hs_gpa_num +
    Form,
  data = df_analysis
)

summary(Model1)
nobs(Model1)

# Standardized coefficients
model_parameters(
  Model1,
  standardize = "refit",
  p_adjust = NULL,
  digits = 4
)


# ---------------------------------------------------------
# Model 2: Cross-group exposure
# ---------------------------------------------------------

Model2 <- lm(
  Avg_Score ~
    race_outgroup_exposure +
    ses_outgroup_exposure +
    pol_outgroup_exposure +
    gender_outgroup_exposure +
    respondents_race +
    gender_num +
    age_cohort +
    mother_edu_years +
    hs_gpa_num +
    Form,
  data = df_analysis
)

summary(Model2)
nobs(Model2)

model_parameters(
  Model2,
  standardize = "refit",
  p_adjust = NULL,
  digits = 4
)


