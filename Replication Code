# =========================================================
# DESCRIPTIVE STATISTICS
# =========================================================

# Analytic sample size
nrow(df_analysis)


# ---------------------------------------------------------
# Respondent race counts and proportions
# ---------------------------------------------------------

df_analysis %>%
  count(respondents_race, .drop = FALSE) %>%
  mutate(
    Percent = round(100 * n / sum(n), 2)
  )


# ---------------------------------------------------------
# Gender counts and proportions
# ---------------------------------------------------------

df_analysis %>%
  count(gender_num) %>%
  mutate(
    Gender = case_when(
      gender_num == 0 ~ "Men",
      gender_num == 1 ~ "Women",
      TRUE ~ NA_character_
    ),
    Percent = round(100 * n / sum(n), 2)
  ) %>%
  select(Gender, n, Percent)


# ---------------------------------------------------------
# Perspective-taking instrument form counts and proportions
# ---------------------------------------------------------

df_analysis %>%
  count(Form) %>%
  mutate(
    Percent = round(100 * n / sum(n), 2)
  )


# ---------------------------------------------------------
# Key continuous variables
# ---------------------------------------------------------

descriptive_statistics <- df_analysis %>%
  summarise(
    across(
      c(
        Avg_Score,
        age_cohort,
        mother_edu_years,
        hs_gpa_num,
        race_diversity_gs_norm,
        ses_diversity_gs_norm,
        pol_diversity_gs_norm,
        gender_diversity_gs_norm,
        total_interaction_exposure,
        race_outgroup_exposure,
        ses_outgroup_exposure,
        pol_outgroup_exposure,
        gender_outgroup_exposure
      ),
      list(
        Mean = ~mean(.x, na.rm = TRUE),
        SD   = ~sd(.x, na.rm = TRUE),
        Min  = ~min(.x, na.rm = TRUE),
        Max  = ~max(.x, na.rm = TRUE)
      )
    )
  ) %>%
  pivot_longer(
    everything(),
    names_to = c("Variable", ".value"),
    names_pattern = "^(.*)_(Mean|SD|Min|Max)$"
  )

descriptive_statistics


